# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server configuration
NODE_ENV="development"
PORT="3000"

# Database Configuration (PostgreSQL on Railway or Local)
# If empty or unavailable, in-memory SQLite/fallback repository will seamlessly power DEMO_MODE
DATABASE_URL="postgresql://postgres:password@localhost:5432/networkcheck"

# Demo Mode toggle
# When true: seeded mock reports and baselines load immediately, simulated USSD & SMS console active
DEMO_MODE="true"

# Africa's Talking Credentials for Nigeria USSD & SMS
AT_USERNAME="sandbox"
AT_API_KEY="your_africastalking_api_key_here"
AT_USSD_SERVICE_CODE="*384*244#"
AT_SENDER_ID="NetCheck"

# Admin Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"
ADMIN_DEFAULT_EMAIL="admin@networkcheck.ng"
ADMIN_DEFAULT_PASSWORD="admin_secure_password_2026"

